{
  "name": "14y-pa-readiness-agent",
  "version": "0.7.1",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "preflight": "npm run verify && npm run seed",
    "docker:build": "docker build -t 14y-pa-readiness-agent:local .",
    "docker:run": "docker run --rm --env-file .env.local -p 3000:3000 14y-pa-readiness-agent:local",
    "aws:install": "npm --prefix infra/aws install",
    "aws:build": "npm --prefix infra/aws run build",
    "aws:synth": "npm --prefix infra/aws run synth",
    "aws:deploy": "./scripts/aws-deploy.sh",
    "aws:destroy": "./scripts/aws-destroy.sh"
  },
  "dependencies": {
    "@medplum/core": "5.1.26",
    "@medplum/fhirtypes": "5.1.26",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "description": "Human-supervised, source-verifiable prior-authorization evidence-readiness prototype on Medplum."
}
